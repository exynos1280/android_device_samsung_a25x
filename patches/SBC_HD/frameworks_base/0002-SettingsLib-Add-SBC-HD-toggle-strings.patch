From e13da8238b09d45266a85a3193a37800eae78536 Mon Sep 17 00:00:00 2001
From: Flopster101 <nahuelgomez329@gmail.com>
Date: Wed, 28 Jan 2026 16:00:56 +0300
Subject: [PATCH 2/2] SettingsLib: Add SBC HD toggle strings

---
 packages/SettingsLib/res/values/strings.xml | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/packages/SettingsLib/res/values/strings.xml b/packages/SettingsLib/res/values/strings.xml
index a3bbcdcab..43bf4d3e4 100644
--- a/packages/SettingsLib/res/values/strings.xml
+++ b/packages/SettingsLib/res/values/strings.xml
@@ -850,6 +850,14 @@
     <string name="bluetooth_show_devices_without_names_summary">Bluetooth devices without names (MAC addresses only) will be displayed</string>
     <!-- Summary of checkbox for disabling Bluetooth absolute volume -->
     <string name="bluetooth_disable_absolute_volume_summary">Disables the Bluetooth absolute volume feature in case of volume issues with remote devices such as unacceptably loud volume or lack of control.</string>
+    <!-- Setting Checkbox title for enabling Bluetooth SBC HD audio -->
+    <string name="bluetooth_enable_sbc_hd">Enable SBC HD audio</string>
+    <!-- Summary of checkbox for enabling Bluetooth SBC HD audio -->
+    <string name="bluetooth_enable_sbc_hd_summary">Use SBC Dual Channel mode with higher bitrates. Toggle Bluetooth after changing.</string>
+    <!-- Setting Checkbox title for forcing max SBC HD bitrate -->
+    <string name="bluetooth_sbc_hd_force_max_bitrate">Force max SBC HD bitrate</string>
+    <!-- Summary of checkbox for forcing max SBC HD bitrate -->
+    <string name="bluetooth_sbc_hd_force_max_bitrate_summary">Force 551 kbps even if device doesn\'t advertise 3Mbps EDR. May cause audio dropouts.</string>
     <!-- Summary of checkbox for enabling Bluetooth Gabeldorche features [CHAR LIMIT=none] -->
     <string name="bluetooth_enable_gabeldorsche_summary">Enables the Bluetooth Gabeldorsche feature stack.</string>
 
