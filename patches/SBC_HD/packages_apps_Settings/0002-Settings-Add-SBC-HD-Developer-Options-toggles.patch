+package com.android.settings.development;
+
+import android.content.Context;
+import android.os.SystemProperties;
+
+import androidx.annotation.VisibleForTesting;
+import androidx.preference.Preference;
+import androidx.preference.TwoStatePreference;
+
+import com.android.settings.core.PreferenceControllerMixin;
+import com.android.settingslib.development.DeveloperOptionsPreferenceController;
+
+/**
+ * Controller for forcing maximum SBC HD bitrate (551 kbps at 44.1kHz).
+ * This bypasses the 3Mbps EDR check and forces 3DH5 packets even if the
+ * device doesn't advertise support. May cause audio dropouts.
+ */
+public class BluetoothSbcHdForceMaxBitrateController extends
+        DeveloperOptionsPreferenceController implements Preference.OnPreferenceChangeListener,
+        PreferenceControllerMixin {
+
+    private static final String BLUETOOTH_SBC_HD_FORCE_MAX_KEY = "bluetooth_sbc_hd_force_max_bitrate";
+    @VisibleForTesting
+    static final String BLUETOOTH_SBC_HD_FORCE_MAX_PROPERTY = "persist.bluetooth.sbc_hd.force_max_bitrate";
+
+    public BluetoothSbcHdForceMaxBitrateController(Context context) {
+        super(context);
+    }
+
+    @Override
+    public String getPreferenceKey() {
+        return BLUETOOTH_SBC_HD_FORCE_MAX_KEY;
+    }
+
+    @Override
+    public boolean onPreferenceChange(Preference preference, Object newValue) {
+        final boolean isEnabled = (Boolean) newValue;
+        SystemProperties.set(BLUETOOTH_SBC_HD_FORCE_MAX_PROPERTY, isEnabled ? "true" : "false");
+        return true;
+    }
+
+    @Override
+    public void updateState(Preference preference) {
+        final boolean isEnabled = SystemProperties.getBoolean(
+                BLUETOOTH_SBC_HD_FORCE_MAX_PROPERTY, false /* default */);
+        ((TwoStatePreference) mPreference).setChecked(isEnabled);
+    }
+
+    @Override
+    protected void onDeveloperOptionsSwitchDisabled() {
+        super.onDeveloperOptionsSwitchDisabled();
+        SystemProperties.set(BLUETOOTH_SBC_HD_FORCE_MAX_PROPERTY, "false");
+        ((TwoStatePreference) mPreference).setChecked(false);
+    }
+}
